# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Place&Play API Configuration
PLACE_AND_PLAY_API_BASE_URL=https://placeandplay-auth-service-production.up.railway.app/PlaceAndPlay/api
PLACE_AND_PLAY_LOGIN_EMAIL=telegrambot@gmail.com
PLACE_AND_PLAY_LOGIN_PASSWORD=your_password_here

# Bot Configuration
BOT_USERNAME=your_bot_username
TELEGRAM_APP_URL=https://app.placeandplay.uz

# Notification service
NOTIFICATION_API_KEY=your_api_key_here
NOTIFICATION_SERVICE_HOST=0.0.0.0
NOTIFICATION_SERVICE_PORT=5000

# Events Service
# Public: https://placeandplay-events-service-production.up.railway.app/PlaceAndPlay
# Railway private: http://placeandplay-events-service.railway.internal:8082/PlaceAndPlay
# (port 8082 is required; without it HTTP uses 80 and connection is refused)
PLACE_AND_PLAY_EVENTS_SERVICE_URL=https://placeandplay-events-service-production.up.railway.app/PlaceAndPlay
TELEGRAM_BOT_API_KEY=
